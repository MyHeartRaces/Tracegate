[Unit]
Description=Tracegate Grafana
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=3
TimeoutStopSec=20
SuccessExitStatus=143
EnvironmentFile=/var/lib/tracegate/artifacts/active/grafana.env
ExecStartPre=/usr/local/sbin/tracegate-artifact-verify grafana
ExecStartPre=-/usr/bin/docker rm -f tracegate-grafana
ExecStart=/usr/bin/docker run --rm --name tracegate-grafana --network host --read-only --cap-drop ALL --security-opt no-new-privileges:true --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --env-file /etc/tracegate/grafana.env -v /var/lib/tracegate/grafana:/var/lib/grafana ${TRACEGATE_IMAGE}
ExecStop=/usr/bin/docker stop tracegate-grafana

[Install]
WantedBy=multi-user.target
