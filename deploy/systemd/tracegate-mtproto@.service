[Unit]
Description=Tracegate MTProto Telemt (%i)
After=docker.service network-online.target tracegate-agent.service
Wants=network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=3
TimeoutStopSec=20
SuccessExitStatus=143
EnvironmentFile=/var/lib/tracegate/artifacts/active/telemt.env
ExecStartPre=/usr/local/sbin/tracegate-artifact-verify telemt
ExecStartPre=-/usr/bin/docker rm -f tracegate-mtproto-%i
ExecStartPre=/opt/tracegate/current/deploy/systemd/tracegate-telemt-permissions
ExecStart=/usr/bin/docker run --rm --name tracegate-mtproto-%i --network host --read-only --cap-drop ALL --security-opt no-new-privileges:true --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --ulimit nofile=65536:65536 -v /var/lib/tracegate/private/mtproto:/var/lib/tracegate/private/mtproto:rw -v /var/lib/tracegate/private/mtproto/runtime/config.toml:/app/config.toml:ro ${TRACEGATE_IMAGE} --data-path /var/lib/tracegate/private/mtproto/runtime /var/lib/tracegate/private/mtproto/runtime/config.toml
ExecReload=/usr/bin/docker kill --signal=HUP tracegate-mtproto-%i
ExecStop=/usr/bin/docker stop tracegate-mtproto-%i

[Install]
WantedBy=multi-user.target
