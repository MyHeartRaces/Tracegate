[Unit]
Description=Tracegate ShadowTLS v3 Endpoint backhaul server #2 (pool leg 2 front)
After=docker.service network-online.target tracegate-xray-ss2022.service
Requires=docker.service

[Service]
# Optional: the ExecStartPre env script renders this on first start.
EnvironmentFile=-/etc/tracegate/private/shadowtls/backhaul2.env
Restart=always
RestartSec=3
TimeoutStopSec=20
SuccessExitStatus=143
EnvironmentFile=/var/lib/tracegate/artifacts/active/shadowtls.env
ExecStartPre=/usr/local/sbin/tracegate-artifact-verify shadowtls
ExecStartPre=/opt/tracegate/current/deploy/systemd/tracegate-shadowtls-backhaul2-env
ExecStartPre=-/usr/bin/docker rm -f tracegate-shadowtls-backhaul2
ExecStart=/usr/bin/docker run --rm --name tracegate-shadowtls-backhaul2 --network host --read-only --cap-drop ALL --security-opt no-new-privileges:true --entrypoint shadow-tls ${TRACEGATE_IMAGE} --v3 server --listen $SHADOWTLS_BACKHAUL2_LISTEN --server 127.0.0.1:18444 --tls $SHADOWTLS_BACKHAUL2_TLS_TARGET --password $SHADOWTLS_BACKHAUL2_PASSWORD
ExecStop=/usr/bin/docker stop tracegate-shadowtls-backhaul2

[Install]
WantedBy=multi-user.target
