#!/usr/bin/env bash
# Public-interface queueing for Tracegate hosts.
#
# Every host gets fq (pacing for BBR). On Entry the host-wide traffic cap from
# the runtime contract (trafficShaping.entry) is applied on the same interface:
#   - TX: HTB root with one class at AGENT_ENTRY_TRAFFIC_SHAPING_MAX_MBIT and fq
#     as its leaf, so pacing is kept under the cap;
#   - RX: optional ingress policer at the same rate, OFF by default since 4.2.2.
#     A policer drops instead of queueing (~1.4 % inbound loss measured on Entry,
#     stalled transfers). Entry relays almost everything it receives, so TCP flow
#     control already holds RX near the TX cap. Opt in with
#     AGENT_ENTRY_TRAFFIC_SHAPING_APPLY_INGRESS_POLICING=true.
# Settings come from the deployment env (role) and the Entry runtime env, with
# the same defaults as tracegate.settings (enabled, 65 Mbit/s).
set -euo pipefail

IP="${TRACEGATE_IP:-ip}"
TC="${TRACEGATE_TC:-tc}"
DEPLOY_ENV="${TRACEGATE_DEPLOY_ENV:-/etc/tracegate/deploy.env}"

command -v "${IP}" >/dev/null 2>&1 || {
  echo "tracegate network qdisc: missing command: ${IP}" >&2
  exit 2
}
command -v "${TC}" >/dev/null 2>&1 || {
  echo "tracegate network qdisc: missing command: ${TC}" >&2
  exit 2
}

load_env() {
  [ -r "$1" ] || return 0
  set -a
  # shellcheck disable=SC1090
  source "$1"
  set +a
}

load_env "${DEPLOY_ENV}"
ROLE="${TRACEGATE_HOST_ROLE:-}"
if [ "${ROLE}" = entry ]; then
  load_env "${TRACEGATE_ENTRY_RUNTIME_ENV:-/etc/tracegate/tracegate-entry.env}"
fi

truthy() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

positive_int() {
  case "${1:-}" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$1" -gt 0 ]
}

NETWORK_INTERFACE="${TRACEGATE_NETWORK_INTERFACE:-}"
SHAPING=0
if [ "${ROLE}" = entry ] && truthy "${AGENT_ENTRY_TRAFFIC_SHAPING_ENABLED:-true}"; then
  SHAPING=1
  SHAPE_MBIT="${AGENT_ENTRY_TRAFFIC_SHAPING_MAX_MBIT:-65}"
  SHAPE_BURST_KBIT="${AGENT_ENTRY_TRAFFIC_SHAPING_BURST_KBIT:-8192}"
  positive_int "${SHAPE_MBIT}" || {
    echo "tracegate network qdisc: invalid AGENT_ENTRY_TRAFFIC_SHAPING_MAX_MBIT: ${SHAPE_MBIT}" >&2
    exit 2
  }
  positive_int "${SHAPE_BURST_KBIT}" || {
    echo "tracegate network qdisc: invalid AGENT_ENTRY_TRAFFIC_SHAPING_BURST_KBIT: ${SHAPE_BURST_KBIT}" >&2
    exit 2
  }
  SHAPE_EGRESS=0
  SHAPE_INGRESS=0
  truthy "${AGENT_ENTRY_TRAFFIC_SHAPING_APPLY_EGRESS:-true}" && SHAPE_EGRESS=1
  truthy "${AGENT_ENTRY_TRAFFIC_SHAPING_APPLY_INGRESS_POLICING:-false}" && SHAPE_INGRESS=1
  [ -n "${NETWORK_INTERFACE}" ] || NETWORK_INTERFACE="${AGENT_ENTRY_TRAFFIC_SHAPING_INTERFACE:-}"
fi

if [ -n "${NETWORK_INTERFACE}" ]; then
  interfaces=("${NETWORK_INTERFACE}")
else
  interfaces=()
  while IFS= read -r interface; do
    [ -z "${interface}" ] || interfaces+=("${interface}")
  done < <(
      "${IP}" -o route show default |
        awk '{for (field_no = 1; field_no <= NF; field_no++) if ($field_no == "dev") print $(field_no + 1)}' |
        sort -u
    )
fi

[ "${#interfaces[@]}" -gt 0 ] || {
  echo "tracegate network qdisc: no default-route interface found" >&2
  exit 2
}

# The policer burst is given in bytes. The HTB class gets an explicit 64 KB burst
# (the kernel default is ~1.6 KB, which undershoots the rate) and a quantum that stays
# well above the MTU without tripping the "quantum is big" warning.
# HTB has no "change" operation: "qdisc replace" on an existing htb 1: root
# fails with "Change operation not supported". Re-runs (every deploy, every
# restart of this unit) therefore keep a matching root and only update the
# class; a root with other parameters is recreated.
shape_egress() {
  local interface="$1" current_root
  current_root="$("${TC}" qdisc show dev "${interface}" root 2>/dev/null || true)"
  case "${current_root}" in
    "qdisc htb 1: root"*"default 0x10"*) ;;
    "qdisc htb 1: root"*)
      "${TC}" qdisc del dev "${interface}" root
      "${TC}" qdisc add dev "${interface}" root handle 1: htb default 10
      ;;
    *) "${TC}" qdisc replace dev "${interface}" root handle 1: htb default 10 ;;
  esac
  "${TC}" class replace dev "${interface}" parent 1: classid 1:10 htb \
    rate "${SHAPE_MBIT}mbit" ceil "${SHAPE_MBIT}mbit" burst 64k cburst 64k quantum 60000
  "${TC}" qdisc replace dev "${interface}" parent 1:10 handle 10: fq
}

shape_ingress() {
  local interface="$1" burst_bytes
  burst_bytes=$(( SHAPE_BURST_KBIT * 1000 / 8 ))
  "${TC}" qdisc del dev "${interface}" ingress >/dev/null 2>&1 || true
  "${TC}" qdisc add dev "${interface}" handle ffff: ingress
  "${TC}" filter add dev "${interface}" parent ffff: protocol all prio 1 matchall \
    action police rate "${SHAPE_MBIT}mbit" burst "${burst_bytes}" conform-exceed drop
}

for interface in "${interfaces[@]}"; do
  "${IP}" link show dev "${interface}" >/dev/null
  if [ "${SHAPING}" -eq 1 ] && [ "${SHAPE_EGRESS}" -eq 1 ]; then
    shape_egress "${interface}"
  else
    "${TC}" qdisc replace dev "${interface}" root fq
  fi
  if [ "${SHAPING}" -eq 1 ] && [ "${SHAPE_INGRESS}" -eq 1 ]; then
    shape_ingress "${interface}"
  elif [ "${ROLE}" = entry ]; then
    # No RX policing on Entry (default, or shaping off): drop a policer left by an earlier run.
    "${TC}" qdisc del dev "${interface}" ingress >/dev/null 2>&1 || true
  fi
  if [ "${SHAPING}" -eq 1 ]; then
    echo "tracegate network qdisc: ${interface}: cap ${SHAPE_MBIT} Mbit/s (tx=${SHAPE_EGRESS} rx=${SHAPE_INGRESS})"
  fi
done
